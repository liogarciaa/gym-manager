<UserControl x:Class="GymManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FontFamily="Segoe UI"
             Background="#e1e1e2"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Estilo de encabezados DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Anulación del recuadro punteado negro de celda -->
        <Style TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Anulación de la selección azul en filas -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1E293B" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1E293B" />
            </Style.Resources>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. ENCABEZADO -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Panel de Control" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Resumen de actividad diaria, concurrencia y control de membresías" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Badge Fecha Actual -->
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="14,8" BorderBrush="#E2E8F0" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtFechaHoy" Text="Lunes, 28 de Septiembre" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. TARJETAS OPERATIVAS -->
            <Grid Grid.Row="1" Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tarjeta 1: Socios Activos -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Socios Activos" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtSociosActivos" Text="0" FontSize="30" FontWeight="Bold" Foreground="#16A34A" Margin="0,10,0,0"/>
                        <TextBlock Text="Inscritos y habilitados" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 2: Asistencias Hoy -->
                <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="Asistencias Hoy" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtAsistenciasHoy" Text="0" FontSize="30" FontWeight="Bold" Foreground="#7C3AED" Margin="0,10,0,0"/>
                        <TextBlock Text="Check-ins realizados hoy" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 3: Cuotas Vencidas -->
                <Border Grid.Column="2" Style="{StaticResource ModernCard}" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="En Mora / Vencidas" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtCuotasVencidas" Text="0" FontSize="30" FontWeight="Bold" Foreground="#DC2626" Margin="0,10,0,0"/>
                        <TextBlock Text="Requieren regularización" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 4: Altas del Mes -->
                <Border Grid.Column="3" Style="{StaticResource ModernCard}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Altas del Mes" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtAltasMes" Text="0" FontSize="30" FontWeight="Bold" Foreground="#2563EB" Margin="0,10,0,0"/>
                        <TextBlock Text="Nuevos socios este mes" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. TABLAS OPERATIVAS EN TIEMPO REAL -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Columna Izquierda: Últimos Accesos de Hoy -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Últimos Ingresos de Hoy" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Ver control de acceso" Background="Transparent" BorderThickness="0" Foreground="#2563EB" FontSize="12" FontWeight="SemiBold" Padding="4,2" Cursor="Hand" Click="BtnIrControlAcceso_Click"/>
                        </Grid>

                        <DataGrid Grid.Row="1" x:Name="GridUltimosAccesos" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  Focusable="False"
                                  HeadersVisibility="Column" 
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#d2d2d2"
                                  Background="White" 
                                  BorderThickness="0" 
                                  AlternatingRowBackground="#F8FAFC"
                                  RowHeight="38"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="95" FontFamily="Consolas" FontSize="12" Foreground="#64748B"/>
                                <DataGridTextColumn Header="Socio" Binding="{Binding NombreCompleto}" Width="*" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <DataGridTextColumn Header="DNI / Código" Binding="{Binding Dni}" Width="120" Foreground="#64748B"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Columna Derecha: Próximos Vencimientos -->
                <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Socios en Tolerancia" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Ver padrón" Background="Transparent" BorderThickness="0" Foreground="#2563EB" FontSize="12" FontWeight="SemiBold" Padding="4,2" Cursor="Hand" Click="BtnIrSocios_Click"/>
                        </Grid>

                        <DataGrid Grid.Row="1" x:Name="GridProximosVencimientos" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  Focusable="False"
                                  HeadersVisibility="Column" 
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  Background="White" 
                                  BorderThickness="0" 
                                  AlternatingRowBackground="#F8FAFC"
                                  RowHeight="38"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vence" Binding="{Binding FechaVencimiento, StringFormat='dd/MM/yyyy'}" Width="100" FontWeight="SemiBold" Foreground="#D97706"/>
                                <DataGridTextColumn Header="Socio" Binding="{Binding NombreCompleto}" Width="*" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120" Foreground="#64748B"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>