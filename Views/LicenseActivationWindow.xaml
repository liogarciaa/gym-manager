<Window x:Class="GymManager.Views.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activar GymManager"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#e1e1e2"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <StackPanel>
            <TextBlock Text="Activar GymManager" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Esta instalación necesita una licencia válida para iniciar." FontSize="13" Foreground="#64748B" Margin="0,6,0,20"/>

            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="IDENTIFICADOR DE ESTA PC" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBox x:Name="TxtInstallationId" IsReadOnly="True" Margin="0,8,0,12" Padding="10,8"
                             FontFamily="Consolas" FontSize="12" Background="#F8FAFC" BorderBrush="#CBD5E1"
                             TextWrapping="Wrap"/>
                    <Button Content="Copiar identificador" HorizontalAlignment="Left" Padding="12,7"
                            Background="#E2E8F0" Foreground="#1E293B" BorderThickness="0" Click="BtnCopiarId_Click"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" Foreground="#B91C1C" FontSize="12" Margin="0,14,0,0"/>
            <Button Content="Seleccionar archivo de licencia" HorizontalAlignment="Right" Margin="0,18,0,0"
                    Padding="16,10" Background="#2563EB" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Click="BtnSeleccionarLicencia_Click"/>
        </StackPanel>
    </Grid>
</Window>