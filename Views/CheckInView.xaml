<UserControl x:Class="GymManager.Views.CheckInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FontFamily="Segoe UI"
             Background="#e1e1e2"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="ModernInputBorder" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo de encabezados DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Botón primario de registro -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="35">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL IZQUIERDO: TERMINAL DE ACCESO Y FEEDBACK -->
        <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0">
            <StackPanel>
                <TextBlock Text="Control de Acceso" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock x:Name="TxtSubtituloTerminal" Text="Pase carnet, llavero NFC o digite el N° de Socio" FontSize="13" Foreground="#64748B" Margin="0,4,0,25"/>

                <!-- Campo de Entrada -->
                <TextBlock x:Name="TxtEtiquetaInput" Text="N° de Socio o Código de Acceso:" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,6"/>
                <Border Style="{StaticResource ModernInputBorder}">
                    <TextBox x:Name="TxtIdentificador" 
                             FontSize="13"
                             FontWeight="Bold" 
                             Foreground="#0F172A"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center" 
                             Padding="12,0" 
                             KeyDown="TxtIdentificador_KeyDown"/>
                </Border>

                <Button Content="Registrar Entrada (Enter)" 
                        Style="{StaticResource BtnPrimary}"
                        Margin="0,12,0,25" 
                        Click="BtnIngresar_Click"/>

                <!-- PANEL DINÁMICO DE ESTADO Y RELOJ EN VIVO -->
                <Border x:Name="BrdResultado" 
                        CornerRadius="10" 
                        Padding="20" 
                        Background="#F8FAFC" 
                        BorderBrush="#CBD5E1" 
                        BorderThickness="1" 
                        MinHeight="200">
                    <Grid VerticalAlignment="Center">
                        <!-- Vista 1: Reloj en Espera (visible por defecto) -->
                        <StackPanel x:Name="PnlRelojEnEspera" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtRelojDigital" Text="00:00:00" FontSize="36" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtFechaEnEspera" Text="Cargando fecha..." FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                            <Border Background="#E2E8F0" CornerRadius="6" Padding="10,4" HorizontalAlignment="Center">
                                <TextBlock Text="ESPERANDO INGRESO" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                            </Border>
                        </StackPanel>

                        <!-- Vista 2: Mensaje de Resultado (Permitido / Tolerancia / Rechazado) -->
                        <StackPanel x:Name="PnlMensajeResultado" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="TxtMensajeEstado" Text="ACCESO PERMITIDO" FontSize="18" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtDetalleSocio" Text="Detalles del socio" FontSize="13" Foreground="#15803D" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center" LineHeight="20"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- PANEL DERECHO: ASISTENCIAS DEL DÍA -->
        <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="20,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ingresos Registrados Hoy" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock x:Name="TxtContadorHoy" Text="0 ingresos registrados hoy" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

            <DataGrid x:Name="GridAsistencias" 
                    Grid.Row="1"
                    AutoGenerateColumns="False" 
                    IsReadOnly="True" 
                    Focusable="False"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    HorizontalGridLinesBrush="#d2d2d2"
                    Background="White"
                    BorderThickness="0"
                    AlternatingRowBackground="#F8FAFC"
                    RowHeight="40"
                    CanUserResizeRows="False"
                    CanUserSortColumns="False">

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent" 
                                            BorderThickness="0" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>

                <!-- Se anula el fondo azul de selección: la fila permanece blanca y el texto legible -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A" />
                        </Style.Resources>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="110" FontFamily="Consolas" FontSize="12" Foreground="#64748B"/>
                    <DataGridTextColumn Header="N° Socio" Binding="{Binding SocioId}" Width="85" Foreground="#64748B"/>
                    <DataGridTextColumn Header="Socio" Binding="{Binding SocioNombre}" Width="2*" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <DataGridTextColumn Header="Vencimiento" Binding="{Binding FechaVencimiento, StringFormat='dd/MM/yyyy'}" Width="130" Foreground="#334155"/>
                </DataGrid.Columns>
            </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>