<Window x:Class="GymManager.Views.AccessDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estado de acceso"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        Loaded="Window_Loaded">
    <Grid Background="#F8FAFC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Border x:Name="BrdResultado"
                Grid.Row="1"
                Grid.Column="1"
                CornerRadius="10"
                Padding="36"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1">
            <Grid VerticalAlignment="Center">
                <StackPanel x:Name="PnlRelojEnEspera" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtRelojDigital" Text="00:00:00" FontSize="64" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtFechaEnEspera" Text="Cargando fecha..." FontSize="20" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,8,0,20"/>
                    <Border Background="#E2E8F0" CornerRadius="6" Padding="16,8" HorizontalAlignment="Center">
                        <TextBlock Text="ESPERANDO INGRESO" FontSize="16" FontWeight="Bold" Foreground="#475569" />
                    </Border>
                </StackPanel>

                <Grid x:Name="PnlMensajeResultado" HorizontalAlignment="Stretch" VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtMensajeEstado" Text="ACCESO PERMITIDO" FontSize="42" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Stretch" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1300"/>
                    <TextBlock x:Name="TxtDetalleSocio" Grid.Row="1" Text="Detalles del socio" FontSize="25" Foreground="#15803D" HorizontalAlignment="Stretch" Margin="0,18,0,0" TextAlignment="Center" TextWrapping="Wrap" LineHeight="36" MaxWidth="1300"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
