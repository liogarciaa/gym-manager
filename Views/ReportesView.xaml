<UserControl x:Class="GymManager.Views.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#e1e1e2"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo de encabezados de columna DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Anulación del recuadro punteado negro de celda -->
        <Style TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Anulación de la selección azul en filas -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1E293B" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1E293B" />
            </Style.Resources>
        </Style>

        <!-- Botón primario azul -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. ENCABEZADO Y SELECTORES DE PERÍODO -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Reportes Mensuales" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Balance contable, evolución de membresías y concurrencia" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Selectores de Mes, Año y Botón Exportar PDF -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="CboMes" Width="140" Style="{StaticResource ModernComboBox}" Margin="0,0,10,0" SelectionChanged="FiltroPeriodo_Changed"/>
                    <ComboBox x:Name="CboAnio" Width="95" Style="{StaticResource ModernComboBox}" Margin="0,0,15,0" SelectionChanged="FiltroPeriodo_Changed"/>

                    <Button Content="Descargar PDF" 
                            Style="{StaticResource BtnPrimary}"
                            Click="BtnDescargarPdf_Click"/>
                </StackPanel>
            </Grid>

            <!-- 2. TARJETAS DE RESUMEN KPI -->
            <Grid Grid.Row="1" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tarjeta 1: Total Recaudado -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Total Recaudado" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtTotalRecaudado" Text="$0.00" FontSize="26" FontWeight="Bold" Foreground="#16A34A" Margin="0,10,0,0"/>
                        <TextBlock x:Name="TxtCantidadPagos" Text="0 pagos registrados" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 2: Socios del Mes -->
                <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="Socios del Mes" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtNuevosSocios" Text="0" FontSize="26" FontWeight="Bold" Foreground="#2563EB" Margin="0,10,0,0"/>
                        <TextBlock Text="Pagaron / renovaron cuota" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 3: Total Asistencias -->
                <Border Grid.Column="2" Style="{StaticResource ModernCard}" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="Total Asistencias" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtTotalAsistencias" Text="0" FontSize="26" FontWeight="Bold" Foreground="#7C3AED" Margin="0,10,0,0"/>
                        <TextBlock Text="Check-ins en el período" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 4: Bonificaciones -->
                <Border Grid.Column="3" Style="{StaticResource ModernCard}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Meses de Regalo ($0)" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtBonificaciones" Text="0" FontSize="26" FontWeight="Bold" Foreground="#D97706" Margin="0,10,0,0"/>
                        <TextBlock Text="Bonificaciones otorgadas" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. DETALLE Y MOROSIDAD -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tabla: Recaudación por Método de Pago -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Recaudación por Método de Pago" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>

                        <DataGrid Grid.Row="1" x:Name="GridMetodos" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  Focusable="False"
                                  HeadersVisibility="Column" 
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#d2d2d2"
                                  Background="White" 
                                  BorderThickness="0" 
                                  AlternatingRowBackground="#F8FAFC"
                                  RowHeight="40"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Método de Cobro" Binding="{Binding Metodo}" Width="*" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <DataGridTextColumn Header="Operaciones" Binding="{Binding Cantidad}" Width="110" Foreground="#64748B"/>
                                <DataGridTextColumn Header="Subtotal" Binding="{Binding Total, StringFormat='C2'}" Width="140" FontWeight="Bold" Foreground="#16A34A"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Estado de Morosidad al Cierre -->
                <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Estado de Morosidad Actual" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>

                        <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtMorosidadResumen" Text="Calculando..." FontSize="14" FontWeight="SemiBold" Foreground="#991B1B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Información operativa:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBlock Text="El total de morosos considera socios activos con fecha de vencimiento expirada o sin pagos registrados. Para contactarlos o regularizarlos, dirigite a la sección Deudores." 
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" LineHeight="18"/>
                        <Button Content="Ver deudores"
                            Style="{StaticResource BtnPrimary}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Click="BtnIrDeudores_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>