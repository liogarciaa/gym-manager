<UserControl x:Class="GymManager.Views.SociosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#e1e1e2"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="ModernInput" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style x:Key="ModernInputBorder" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo moderno para el botón primario + Nuevo Socio -->
        <Style x:Key="BtnPrimaryStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de encabezados de columna del DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- FILA 0: ENCABEZADO -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel>
                <TextBlock Text="Padrón de Socios" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Alta, seguimiento de membresías, historial de pagos y vencimientos" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- FILA 1: BARRA DE BÚSQUEDA Y ACCIÓN -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="500" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Cuadro de Búsqueda con Placeholder gris interactivo e icono -->
            <Border Grid.Column="0" Style="{StaticResource ModernInputBorder}">
                <Grid VerticalAlignment="Center">
                    <!-- TextBox real -->
                    <TextBox x:Name="TxtBuscar"
                             Style="{StaticResource ModernInput}"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center" 
                             GotKeyboardFocus="TxtBuscar_GotKeyboardFocus"
                             LostKeyboardFocus="TxtBuscar_LostKeyboardFocus"
                             TextChanged="TxtBuscar_TextChanged"/>

                    <!-- Texto gris indicativo (Placeholder) -->
                    <TextBlock x:Name="TxtBuscarPlaceholder" Text="Buscar socio por Nombre, Apellido, DNI o ID..."
                               Margin="12,0"
                               FontSize="13" 
                               Foreground="#94A3B8" 
                               IsHitTestVisible="False" 
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtBuscar}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Botón Crear Nuevo Socio -->
            <Button Grid.Column="2" 
                    Content="+ Nuevo Socio" 
                    Style="{StaticResource BtnPrimaryStyle}"
                    Click="BtnNuevoSocio_Click" />
        </Grid>

        <!-- FILA 2: TABLA DE DATOS -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" MouseDown="Fondo_MouseDown">
            <DataGrid x:Name="SociosDataGrid" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      PreviewKeyDown="SociosDataGrid_PreviewKeyDown"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#d2d2d2"
                      BorderThickness="0"
                      Background="White"
                      AlternatingRowBackground="#F8FAFC"
                      RowHeight="42"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      Focusable="False"
                      HeadersVisibility="Column"
                      MouseDoubleClick="SociosDataGrid_MouseDoubleClick"
                      PreviewMouseDown="SociosDataGrid_PreviewMouseDown">

                <!-- Quitar el foco cuadrado feo en celdas -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>

                <!-- Mantener la selección transparente y legible. -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A" />
                        </Style.Resources>
                    </Style>
                </DataGrid.RowStyle>

                <!-- Menú contextual al hacer clic derecho -->
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Editar Datos" Click="MenuEditar_Click" />
                        <MenuItem Header="Cambiar Estado (Activo / Inactivo)" Click="MenuCambiarEstado_Click" />
                        <MenuItem Header="Registrar Pago" Click="MenuRegistrarPago_Click"/>
                        <MenuItem Header="Ver Historial de Pagos" Click="MenuHistorialPagos_Click"/>
                        <Separator/>
                        <MenuItem Header="Eliminar Socio" Click="MenuEliminarSocio_Click" Foreground="#DC2626" FontWeight="SemiBold"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" IsReadOnly="True" FontWeight="Bold" Foreground="#64748B"/>
                    <DataGridTextColumn Header="Nombre y Apellido" Binding="{Binding NombreCompleto}" Width="2*" IsReadOnly="True" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="*" IsReadOnly="True" Foreground="#475569"/>
                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="*" IsReadOnly="True" Foreground="#475569"/>
                    <DataGridTextColumn Header="Alta" Binding="{Binding FechaAlta, StringFormat=dd/MM/yyyy}" Width="100" IsReadOnly="True" Foreground="#64748B"/>
                    <DataGridTextColumn Header="Vencimiento" Binding="{Binding FechaVencimiento, StringFormat='dd/MM/yyyy'}" Width="110" IsReadOnly="True" FontWeight="SemiBold" Foreground="#334155"/>

                    <!-- Columna Cuota: Formateada como Chip / Badge -->
                    <DataGridTemplateColumn Header="Cuota" Width="115" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- Por defecto / Sin pagos -->
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EstadoCuota}" Value="Al día">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EstadoCuota}" Value="Vencido">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding EstadoCuota}" FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstadoCuota}" Value="Al día">
                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EstadoCuota}" Value="Vencido">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- CheckBox Activo / Inactivo -->
                    <DataGridTemplateColumn Header="Activo" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding EstaActivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          Cursor="Hand"
                                          PreviewMouseLeftButtonDown="ChkActivo_PreviewMouseLeftButtonDown" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>