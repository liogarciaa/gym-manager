<Window x:Class="GymManager.Views.RutinaQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR de rutina"
        Width="760"
        Height="720"
        MinWidth="700"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Rutina para escanear" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Este QR contiene el texto de la rutina y se puede leer sin Internet." FontSize="12" Margin="0,4,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="470"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10"
                    Padding="14" HorizontalAlignment="Center">
                <Image x:Name="ImgQr" Width="440" Height="440" Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>

            <TextBox x:Name="TxtContenido" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="12" Background="White"
                     BorderBrush="#CBD5E1" FontFamily="Consolas" FontSize="12"
                     FocusVisualStyle="{x:Null}" Margin="12,0,0,0"/>
        </Grid>

        <Button Grid.Row="2" Content="Cerrar" Width="100" Height="36" HorizontalAlignment="Right"
                Style="{StaticResource RutinasBotonSecundario}" Margin="0,14,0,0" IsCancel="True"/>
    </Grid>
</Window>
