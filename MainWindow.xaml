<Window x:Class="GymManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gym Manager" 
        Height="720" 
        Width="1325" 
        MinHeight="600" 
        MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="#e1e1e2"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded"
        Activated="Window_Activated">

    <Window.Resources>
        <!-- Estilo moderno para ítems de navegación lateral con selección activa -->
        <Style x:Key="SidebarButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="12,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover al pasar el mouse por encima -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <!-- Estado activo fijado cuando se hace clic -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReaderModeButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="modeBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="modeBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="modeBorder" Property="Background" Value="#183B38"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR DE NAVEGACIÓN -->
        <Border Grid.Column="0" Background="#0F172A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Encabezado de Marca -->
                <StackPanel Grid.Row="0" Margin="20,30,20,25">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                        <Border Width="32" Height="32" CornerRadius="5" Background="#334155">
                            <TextBlock Text="G" FontSize="15" FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="GYM MANAGER" FontSize="13" FontWeight="ExtraBold" Foreground="White"/>
                            <TextBlock Text="Gestión del gimnasio" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#1E293B" CornerRadius="6" Padding="10,8" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ESTABLECIMIENTO" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtNombreGym"
                                       Text="Mi Gimnasio"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#38BDF8"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- 2. Lista de Navegación -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <RadioButton x:Name="NavInicio" Content="Inicio"
                                     GroupName="SidebarNav"
                                     IsChecked="True"
                                     Style="{StaticResource SidebarButtonStyle}" 
                                     Click="BtnNavInicio_Click"/>

                        <RadioButton x:Name="NavSocios" Content="Socios"
                                     GroupName="SidebarNav"
                                     Style="{StaticResource SidebarButtonStyle}" 
                                     Click="BtnNavSocios_Click"/>

                        <RadioButton x:Name="NavControlAcceso" Content="Control Acceso"
                                     GroupName="SidebarNav"
                                     Style="{StaticResource SidebarButtonStyle}" 
                                     Click="BtnNavAsistencia_Click"/>

                        <RadioButton x:Name="NavDeudores" Content="Deudores"
                                     GroupName="SidebarNav"
                                     Style="{StaticResource SidebarButtonStyle}" 
                                     Click="BtnNavDeudores_Click"/>

                        <RadioButton x:Name="NavPagos" Content="Caja y Cobranzas"
                                     GroupName="SidebarNav"
                                     Style="{StaticResource SidebarButtonStyle}" 
                                     Click="BtnNavPagos_Click"/>

                        <RadioButton x:Name="NavReportes" Content="Reportes"
                                     GroupName="SidebarNav"
                                     Style="{StaticResource SidebarButtonStyle}" 
                                     Click="BtnNavReportes_Click"/>

                        <Border Height="1" Background="#1E293B" Margin="16,12"/>

                        <RadioButton x:Name="NavConfiguracion" Content="Configuración"
                                     GroupName="SidebarNav"
                                     Style="{StaticResource SidebarButtonStyle}" 
                                     Click="BtnNavConfiguracion_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Versión y Firma al pie del Sidebar (Fila 2 fija abajo) -->
                <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,15,0,20" HorizontalAlignment="Center">
                    <TextBlock Text="v1.0.0 • Professional Edition" 
                               FontSize="11" 
                               Foreground="#475569" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Designed by Lionel García" 
                               FontSize="10" 
                               FontWeight="SemiBold" 
                               Foreground="#334155" 
                               HorizontalAlignment="Center" 
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ÁREA CENTRAL DE CONTENIDO -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="25,6,35,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnBack" Click="BtnBack_Click"
                            IsEnabled="False" Style="{StaticResource HistoryButtonStyle}"
                            ToolTip="Volver a la pantalla anterior (Alt + Flecha izquierda o botón atrás del mouse)">
                        <Path Data="M 14,3 L 6,11 L 14,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button x:Name="BtnForward" Click="BtnForward_Click" Margin="4,0,0,0"
                            IsEnabled="False" Style="{StaticResource HistoryButtonStyle}"
                            ToolTip="Avanzar a la siguiente pantalla (Alt + Flecha derecha o botón adelante del mouse)">
                        <Path Data="M 6,3 L 14,11 L 6,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>

                <Border x:Name="PanelLectorGlobal" Grid.Column="1" Visibility="Collapsed"
                        Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8"
                        Height="36" Margin="14,0,10,0" VerticalAlignment="Center">
                    <Grid>
                        <TextBox x:Name="TxtLectorGlobal" FontSize="12" Foreground="#0F172A"
                                 Background="Transparent" BorderThickness="0" Padding="11,0"
                                 VerticalContentAlignment="Center" KeyDown="TxtLectorGlobal_KeyDown"
                                 ToolTip="Escaneá un llavero o escribí un ID, DNI o UID y presioná Enter"/>
                        <TextBlock x:Name="TxtLectorPlaceholder" Text="Escaneá un llavero para registrar una entrada..."
                                   Margin="12,0" VerticalAlignment="Center" Foreground="#94A3B8"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtLectorGlobal}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <StackPanel x:Name="PanelModoLector" Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <RadioButton x:Name="ModoEntrada" Content="Entrada" GroupName="ReaderMode"
                                 IsChecked="True" Style="{StaticResource ReaderModeButtonStyle}"
                                 Click="ModoEntrada_Click" ToolTip="El próximo escaneo se procesa como una entrada"/>
                    <RadioButton x:Name="ModoBuscarSocio" Content="Buscar socio" GroupName="ReaderMode"
                                 Style="{StaticResource ReaderModeButtonStyle}"
                                 Click="ModoBuscarSocio_Click" ToolTip="El próximo escaneo busca la ficha sin registrar asistencia"/>
                </StackPanel>
            </Grid>

            <ContentControl x:Name="MainContent" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>