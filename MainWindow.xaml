<Window x:Class="GymManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gym Manager" 
        Height="720" 
        Width="1325" 
        MinHeight="600" 
        MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="#e1e1e2"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Estilo moderno para ítems de navegación lateral con selección activa -->
        <Style x:Key="SidebarButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="12,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover al pasar el mouse por encima -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <!-- Estado activo fijado cuando se hace clic -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR DE NAVEGACIÓN -->
        <Border Grid.Column="0" Background="#0F172A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Encabezado de Marca -->
                <StackPanel Grid.Row="0" Margin="20,30,20,25">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                        <Border Width="32" Height="32" CornerRadius="5" Background="#334155">
                            <TextBlock Text="G" FontSize="15" FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="GYM MANAGER" FontSize="13" FontWeight="ExtraBold" Foreground="White"/>
                            <TextBlock Text="Gestión del gimnasio" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#1E293B" CornerRadius="6" Padding="10,8" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ESTABLECIMIENTO" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtNombreGym"
                                       Text="Mi Gimnasio"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#38BDF8"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 2. Lista de Navegación -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <RadioButton x:Name="NavInicio" Content="Inicio"
                                     GroupName="SidebarNav"
                                     IsChecked="True"
                                     Style="{StaticResource SidebarButtonStyle}" 
                                     Click="BtnNavInicio_Click"/>

                        <RadioButton x:Name="NavSocios" Content="Socios"
                                     GroupName="SidebarNav"
                                     Style="{StaticResource SidebarButtonStyle}" 
                                     Click="BtnNavSocios_Click"/>

                        <RadioButton x:Name="NavControlAcceso" Content="Control Acceso"
                                     GroupName="SidebarNav"
                                     Style="{StaticResource SidebarButtonStyle}" 
                                     Click="BtnNavAsistencia_Click"/>

                        <RadioButton x:Name="NavDeudores" Content="Deudores"
                                     GroupName="SidebarNav"
                                     Style="{StaticResource SidebarButtonStyle}" 
                                     Click="BtnNavDeudores_Click"/>

                        <RadioButton Content="Caja y Cobranzas"
                                     GroupName="SidebarNav"
                                     Style="{StaticResource SidebarButtonStyle}" 
                                     Click="BtnNavPagos_Click"/>

                        <RadioButton Content="Reportes"
                                     GroupName="SidebarNav"
                                     Style="{StaticResource SidebarButtonStyle}" 
                                     Click="BtnNavReportes_Click"/>

                        <Border Height="1" Background="#1E293B" Margin="16,12"/>

                        <RadioButton Content="Configuración"
                                     GroupName="SidebarNav"
                                     Style="{StaticResource SidebarButtonStyle}" 
                                     Click="BtnNavConfiguracion_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Versión y Firma al pie del Sidebar (Fila 2 fija abajo) -->
                <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,15,0,20" HorizontalAlignment="Center">
                    <TextBlock Text="v1.0.0 • Professional Edition" 
                               FontSize="11" 
                               Foreground="#475569" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Designed by Lionel García" 
                               FontSize="10" 
                               FontWeight="SemiBold" 
                               Foreground="#334155" 
                               HorizontalAlignment="Center" 
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ÁREA CENTRAL DE CONTENIDO -->
        <ContentControl x:Name="MainContent" Grid.Column="1"/>
    </Grid>
</Window>